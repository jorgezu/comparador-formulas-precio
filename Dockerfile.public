FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PORT=8000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-public.txt /app/requirements-public.txt
RUN pip install --no-cache-dir -r /app/requirements-public.txt \
    && groupadd --gid 10001 formula \
    && useradd --uid 10001 --gid formula --no-create-home formula

COPY src/cepos/__init__.py /app/src/cepos/__init__.py
COPY src/cepos/formula_simulation/__init__.py /app/src/cepos/formula_simulation/__init__.py
COPY src/cepos/formula_simulation/models.py /app/src/cepos/formula_simulation/models.py
COPY src/cepos/formula_simulation/engine.py /app/src/cepos/formula_simulation/engine.py
COPY src/cepos/formula_simulation/comparison.py /app/src/cepos/formula_simulation/comparison.py
COPY src/cepos/formula_web /app/src/cepos/formula_web
COPY src/cepos/web/templates /app/src/cepos/web/templates
COPY src/cepos/web/static/formula-public.css /app/src/cepos/web/static/formula-public.css
COPY src/cepos/web/static/formula-public-analysis.js /app/src/cepos/web/static/formula-public-analysis.js
COPY src/cepos/web/static/formula-format.js /app/src/cepos/web/static/formula-format.js
COPY src/cepos/web/static/formula-lab.js /app/src/cepos/web/static/formula-lab.js
COPY src/cepos/web/static/formula-venn-header.png /app/src/cepos/web/static/formula-venn-header.png
COPY src/cepos/web/static/formula-equations-strip.png /app/src/cepos/web/static/formula-equations-strip.png
COPY config/public_tools/formula_price_comparator_v1.json /app/config/public_tools/formula_price_comparator_v1.json

USER formula
EXPOSE 8000

CMD ["python", "-m", "cepos.formula_web.server"]
